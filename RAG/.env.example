# =========================================================
# Jipsa RAG Environment Variable Example
# =========================================================
# .env.local, .env.development, .env.test 작성 시 참고하는 예시입니다.
#
# 이 파일에는 실제 DB 비밀번호, 내부 인증 토큰 또는 외부 API Key를
# 입력하지 않습니다.
#
# .env.example만 Git에 커밋하고 실제 환경별 dotenv 파일은 제외합니다.
#
# RAG는 AWS Access Key, Secret Access Key 또는 Session Token을
# 사용하지 않습니다.
#
# S3 파일은 EC2 애플리케이션 서버가 IAM Role을 사용해 발급한
# Presigned GET URL을 통해 다운로드합니다.
#
# 실행 환경 선택:
#
# - 미지정      -> .env.local
# - development -> .env.development
# - test        -> .env.test
#
# development 실행 예시:
#
# $env:JIPSA_RAG_APP_ENV = "development"
# uv run uvicorn jipsa_rag.main:app --reload


# =========================================================
# Application
# =========================================================

# Swagger UI와 OpenAPI 문서에 표시할 서비스 이름입니다.
JIPSA_RAG_APP_NAME="Jipsa RAG Service"

# 현재 RAG 애플리케이션 버전입니다.
JIPSA_RAG_APP_VERSION=0.1.0

# RAG API v1 엔드포인트에 공통으로 적용할 prefix입니다.
#
# POST /ingest는 루트 경로에 직접 등록되므로
# 이 prefix의 영향을 받지 않습니다.
JIPSA_RAG_API_V1_PREFIX=/api/v1

# 외부 또는 같은 네트워크의 다른 장치가 RAG 서버에 접근해야 하면
# 모든 IPv4 네트워크 인터페이스에서 수신하도록 0.0.0.0을 사용합니다.
#
# 로컬 PC에서만 접근할 경우에는 127.0.0.1로 변경할 수 있습니다.
JIPSA_RAG_HOST=0.0.0.0

# FastAPI 서버가 로컬 PC에서 실제로 수신할 내부 포트입니다.
#
# 공유기 포트 포워딩을 사용할 경우 외부 포트와 내부 포트는
# 서로 다를 수 있습니다.
JIPSA_RAG_PORT=8077

# 디버그 모드 사용 여부입니다.
JIPSA_RAG_DEBUG=true


# =========================================================
# RAG Network Exposure and Diagnostics
# =========================================================

# 백엔드 서버가 RAG 서버를 호출할 때 사용할 외부 기본 주소입니다.
#
# 허용 형식:
#
# - http://호스트:포트
# - https://호스트
# - https://호스트:포트
#
# URL 끝에는 /를 붙이지 않으며 /ingest 또는 /api/v1 같은
# API 경로를 포함하지 않습니다.
#
# TLS가 없는 DDNS와 공유기 포트 포워딩을 사용할 수 있도록
# HTTP도 허용하지만, 내부 인증 토큰 보호를 위해 HTTPS 사용을 권장합니다.
#
# 외부 주소가 아직 없거나 로컬에서만 사용하는 경우 비워 둡니다.
#
# 예:
#
# JIPSA_RAG_EXTERNAL_BASE_URL=http://rag.example.com:9802
# JIPSA_RAG_EXTERNAL_BASE_URL=https://rag.example.com
JIPSA_RAG_EXTERNAL_BASE_URL=

# RAG 외부 노출에 사용하는 터널 제공자입니다.
#
# 허용값:
#
# - none
# - cloudflare
# - ngrok
# - tailscale
# - custom
#
# DDNS와 공유기 포트 포워딩만 사용하는 경우에는 none입니다.
#
# cloudflare, ngrok, tailscale 또는 custom을 사용하면
# JIPSA_RAG_EXTERNAL_BASE_URL도 반드시 입력해야 합니다.
JIPSA_RAG_TUNNEL_PROVIDER=none

# 현재 RAG 프로세스가 외부 요청에 사용하는 공인 IP를 확인할 URL입니다.
#
# 기본 서비스는 다음 JSON 형식을 반환합니다.
#
# {
#   "ip": "공인 IP"
# }
JIPSA_RAG_OUTBOUND_IP_LOOKUP_URL=https://api.ipify.org?format=json

# outbound 공인 IP 조회 요청 제한 시간입니다.
#
# 단위는 초이며 최대 30초까지 허용합니다.
JIPSA_RAG_NETWORK_DIAGNOSTICS_TIMEOUT_SECONDS=5.0


# =========================================================
# Internal Service Authentication
# =========================================================

# RAG 서버가 백엔드의 /internal/** API를 호출할 때
# X-Internal-Token 헤더에 전달하는 공유 시크릿입니다.
#
# 다음 API 호출에 사용합니다.
#
# - GET /internal/files/{fileIdx}/manifest
# - POST /internal/files/{fileIdx}/ingest-complete
#
# 백엔드의 INTERNAL_TOKEN과 반드시 동일해야 합니다.
#
# 실제 토큰은 .env.local, .env.development, .env.test 또는
# 배포 환경 변수에만 저장합니다.
#
# 최소 32자 이상의 예측하기 어려운 임의 문자열을 사용합니다.
INTERNAL_TOKEN=CHANGE_ME_TO_SECURE_RANDOM_INTERNAL_TOKEN

# 백엔드가 RAG 서버의 POST /ingest 요청을 호출할 때
# X-Internal-Token 헤더에 전달하는 공유 시크릿입니다.
#
# 백엔드의 RAG_INGEST_TOKEN과 반드시 동일해야 합니다.
#
# 실제 토큰은 .env.local, .env.development, .env.test 또는
# 배포 환경 변수에만 저장합니다.
#
# 최소 32자 이상의 예측하기 어려운 임의 문자열을 사용합니다.
RAG_INGEST_TOKEN=CHANGE_ME_TO_SECURE_RANDOM_RAG_INGEST_TOKEN


# =========================================================
# Local RAG MySQL
# =========================================================

# Local RAG MySQL 서버 주소입니다.
JIPSA_RAG_DATABASE_HOST=127.0.0.1

# MySQL 연결 포트입니다.
JIPSA_RAG_DATABASE_PORT=3306

# Local RAG 데이터베이스 이름입니다.
JIPSA_RAG_DATABASE_NAME=Jipsa_Local_RAG

# Local RAG 데이터베이스 접속 계정입니다.
JIPSA_RAG_DATABASE_USER=jipsa

# 실제 환경별 dotenv 파일에서 MySQL 비밀번호로 교체합니다.
JIPSA_RAG_DATABASE_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# Local RAG DDL에서 사용하는 문자 집합입니다.
JIPSA_RAG_DATABASE_CHARSET=utf8mb4

# 애플리케이션 시작 시 SELECT 1 연결 검사 여부입니다.
JIPSA_RAG_DATABASE_CHECK_ON_STARTUP=true

# SQLAlchemy가 실행한 SQL을 콘솔에 출력할지 결정합니다.
#
# SQL과 바인딩 값이 노출될 수 있으므로 기본값은 false로 유지합니다.
JIPSA_RAG_DATABASE_ECHO=false


# =========================================================
# S3 Object Key Validation
# =========================================================

# RAG는 S3에 직접 인증하지 않습니다.
#
# 애플리케이션 서버가 전달한 S3 Object Key가
# 허용된 files/ 경로에 속하는지 검증할 때 사용합니다.
JIPSA_RAG_S3_ALLOWED_KEY_PREFIX=files/


# =========================================================
# File Download
# =========================================================

# Presigned GET URL에서 허용할 호스트 suffix입니다.
#
# 여러 값은 쉼표로 구분합니다.
JIPSA_RAG_FILE_DOWNLOAD_ALLOWED_HOST_SUFFIXES=.amazonaws.com

# Presigned URL 서버와 연결을 수립할 때 기다리는 최대 시간입니다.
#
# 단위는 초입니다.
JIPSA_RAG_FILE_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=5.0

# 연결 이후 다운로드 데이터 청크를 기다리는 최대 시간입니다.
#
# 전체 다운로드 제한 시간이 아니라 연속된 데이터 청크 사이의
# 최대 대기 시간이며 단위는 초입니다.
JIPSA_RAG_FILE_DOWNLOAD_READ_TIMEOUT_SECONDS=60.0

# 다운로드할 수 있는 단일 파일의 최대 크기입니다.
#
# 기본값은 50 MiB입니다.
JIPSA_RAG_FILE_DOWNLOAD_MAX_SIZE_BYTES=52428800


# =========================================================
# Document Parsing and Structure-preserving Chunking
# =========================================================

# 형식별 문서 구조를 보존하는 청크의 최대 문자 수입니다.
#
# 기존 PDF 청크 경계와 결정적 Chunk ID 하위 호환성을 유지하기 위해
# 기존 CharacterTextChunker 기본값과 동일한 1,000자를 사용합니다.
JIPSA_RAG_CHUNK_SIZE_CHARS=1000

# 인접 청크 사이에서 다시 포함할 최대 문자 수입니다.
#
# overlap은 chunk size보다 반드시 작아야 하며, 기존 PDF 청킹 결과와
# 결정적 Chunk ID를 유지하기 위해 기본값 200자를 사용합니다.
JIPSA_RAG_CHUNK_OVERLAP_CHARS=200

# 청킹 정책 및 결정적 Chunk ID 계약 버전입니다.
#
# 구조 위치 메타데이터만 확장하고 청크 본문, Content Hash 및 Chunk ID
# 생성 입력은 변경하지 않으므로 현재 버전 2를 유지합니다.
#
# 향후 청크 경계 또는 Chunk ID 생성 규칙을 변경할 때만 증가시킵니다.
JIPSA_RAG_INDEX_VERSION=2

# DOCX, PPTX, XLSX는 ZIP 기반 OOXML 문서이므로 압축 해제 전에
# 중앙 디렉터리를 검사하여 ZIP Bomb과 비정상 압축 파일을 차단합니다.

# OOXML 압축 파일에서 허용할 최대 엔트리 수입니다.
JIPSA_RAG_OOXML_MAX_MEMBER_COUNT=20000

# OOXML 전체 엔트리의 압축 해제 후 합산 최대 크기입니다.
#
# 기본값은 512 MiB입니다.
JIPSA_RAG_OOXML_MAX_TOTAL_UNCOMPRESSED_BYTES=536870912

# OOXML 단일 엔트리의 압축 해제 후 최대 크기입니다.
#
# 기본값은 128 MiB이며 전체 해제 크기 한계보다 클 수 없습니다.
JIPSA_RAG_OOXML_MAX_MEMBER_UNCOMPRESSED_BYTES=134217728

# 압축 크기 대비 압축 해제 크기의 최대 비율입니다.
#
# 크기가 0인 엔트리, 암호화 엔트리, 경로 순회, 중복 엔트리와 함께
# 비정상적으로 높은 압축률을 가진 문서를 파싱 전에 거부합니다.
JIPSA_RAG_OOXML_MAX_COMPRESSION_RATIO=200.0


# =========================================================
# Document Image Extraction
# =========================================================

# PDF, DOCX, PPTX, XLSX 내부 이미지를 추출하여 OCR 후보로 전달합니다.
JIPSA_RAG_IMAGE_EXTRACTION_ENABLED=true

# 한 문서에서 추출할 수 있는 이미지 개수와 바이트 상한입니다.
JIPSA_RAG_IMAGE_MAX_COUNT_PER_DOCUMENT=300
JIPSA_RAG_IMAGE_MAX_BYTES=26214400
JIPSA_RAG_IMAGE_MAX_TOTAL_BYTES=268435456

# 디코딩 후 단일 이미지에 허용할 최대 전체 픽셀 수입니다.
# width * height 값을 기준으로 검사하여 이미지 압축 폭탄을 차단합니다.
JIPSA_RAG_IMAGE_MAX_PIXELS=40000000

# 동일 이미지 바이트의 SHA-256 Hash를 기준으로 중복 추출과 중복 OCR을 방지합니다.
JIPSA_RAG_IMAGE_HASH_DEDUP_ENABLED=true


# =========================================================
# Decorative Image Filter
# =========================================================

# 작은 아이콘, 로고, 배지, 구분선 및 장식 이미지를 OCR 대상에서 제외합니다.
JIPSA_RAG_IMAGE_DECORATIVE_FILTER_ENABLED=true

# 아래 조건 중 하나라도 충족하지 못하면 장식 이미지 후보로 제외합니다.
JIPSA_RAG_IMAGE_MIN_BYTES=1024
JIPSA_RAG_IMAGE_MIN_WIDTH_PX=64
JIPSA_RAG_IMAGE_MIN_HEIGHT_PX=32
JIPSA_RAG_IMAGE_MIN_AREA_PIXELS=4096

# 지나치게 가늘고 긴 배너 또는 구분선 이미지를 제외할 최대 종횡비입니다.
JIPSA_RAG_IMAGE_MAX_ASPECT_RATIO=12.0


# =========================================================
# Scanned PDF Detection and Rendering
# =========================================================

# 페이지 텍스트가 이 문자 수 이하이면 스캔 페이지 후보로 검사합니다.
JIPSA_RAG_SCAN_PDF_TEXT_THRESHOLD_CHARS=24

# 페이지 전체 면적에서 이미지가 차지하는 최소 비율입니다.
JIPSA_RAG_SCAN_PDF_IMAGE_COVERAGE_RATIO=0.60

# 스캔 PDF와 이미지 전용 페이지를 OCR용 PNG로 렌더링할 DPI입니다.
JIPSA_RAG_SCAN_PDF_RENDER_DPI=200


# =========================================================
# Microsoft Office 2024 COM Rendering
# =========================================================

# PowerPoint 2024 차트·SmartArt와 Excel 2024 차트를 원본 Office 엔진으로
# 직접 PNG 출력합니다. LibreOffice와 soffice.exe는 사용하지 않습니다.
JIPSA_RAG_OFFICE_RENDERING_ENABLED=true

# 현재 지원하는 무료 로컬 렌더링 구현체입니다.
JIPSA_RAG_OFFICE_RENDERING_PROVIDER=microsoft_office_com

# COM 자동화는 Windows 로컬 또는 RDP 로그인 세션에서만 허용합니다.
# Windows 서비스, SYSTEM 계정 및 비대화형 세션에서는 렌더링을 건너뜁니다.
JIPSA_RAG_OFFICE_COM_REQUIRE_INTERACTIVE_SESSION=true

# PowerPoint와 Excel COM은 STA 기반이므로 항상 문서 하나씩 직렬 처리합니다.
JIPSA_RAG_OFFICE_RENDER_MAX_CONCURRENCY=1

# 문서 하나의 Office 렌더링 대기 제한 시간과 PowerPoint PNG 출력 DPI입니다.
JIPSA_RAG_OFFICE_RENDER_TIMEOUT_SECONDS=120.0
JIPSA_RAG_OFFICE_RENDER_DPI=160


# =========================================================
# CUDA EasyOCR
# =========================================================

# 이미지 OCR 활성화 여부입니다.
# 테스트 환경은 GPU·모델 파일 없이 전체 Pytest를 실행할 수 있도록 false를 사용합니다.
JIPSA_RAG_OCR_ENABLED=true

# EasyOCR 언어 코드를 쉼표로 구분합니다.
JIPSA_RAG_OCR_LANGUAGES_CSV=ko,en

# GPU 사용 여부와 CUDA가 없을 때 실행을 실패시킬지 결정합니다.
JIPSA_RAG_OCR_GPU=true
JIPSA_RAG_OCR_GPU_REQUIRED=true

# EasyOCR와 PyTorch가 사용할 장치 식별자입니다.
JIPSA_RAG_OCR_DEVICE=cuda:0

# EasyOCR detection/recognition 모델 파일을 저장하고 읽을 디렉터리입니다.
# 실제 이미지 원본이나 OCR 결과는 이 경로에 저장하지 않습니다.
JIPSA_RAG_OCR_MODEL_STORAGE_DIRECTORY=.cache/easyocr

# 최초 OCR 실행에서 필요한 모델을 위 디렉터리에 자동 다운로드합니다.
# 다운로드가 끝난 뒤에는 같은 파일을 재사용하므로 매 실행마다 받지 않습니다.
JIPSA_RAG_OCR_MODEL_DOWNLOAD_ENABLED=true

# 동시에 실행할 OCR 추론 수입니다. GPU VRAM이 부족하면 1로 낮춥니다.
JIPSA_RAG_OCR_MAX_CONCURRENCY=2

# 단일 이미지와 문서 전체 OCR의 최대 처리 시간입니다.
JIPSA_RAG_OCR_TIMEOUT_SECONDS=45.0
JIPSA_RAG_OCR_DOCUMENT_TIMEOUT_SECONDS=600.0

# 이 값보다 신뢰도가 낮은 OCR 줄은 검색 청크에 포함하지 않습니다.
JIPSA_RAG_OCR_MIN_CONFIDENCE=0.35

# OCR 청크에 연결할 주변 문맥과 이미지별 OCR 텍스트의 최대 길이입니다.
JIPSA_RAG_OCR_CONTEXT_MAX_CHARS=700
JIPSA_RAG_OCR_TEXT_MAX_CHARS_PER_IMAGE=20000


# =========================================================
# Embedding Service
# =========================================================

# 임베딩 생성 서버 구현체입니다.
#
# 현재는 Hugging Face Text Embeddings Inference를 사용합니다.
JIPSA_RAG_EMBEDDING_PROVIDER=tei

# Windows 호스트에서 실행하는 RAG 서버가
# Docker TEI 임베딩 서버에 접근하는 기본 주소입니다.
#
# 백엔드가 사용하는 8080 포트와 충돌하지 않도록
# TEI의 호스트 포트는 18081로 분리합니다.
JIPSA_RAG_EMBEDDING_BASE_URL=http://127.0.0.1:18081

# TEI에서 로드할 Hugging Face 임베딩 모델입니다.
JIPSA_RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Qwen3-Embedding-0.6B의 임베딩 출력 차원입니다.
JIPSA_RAG_EMBEDDING_DIM=1024

# 한 번의 TEI 요청에 포함할 최대 청크 수입니다.
#
# 현재 TEI 기본 최대 클라이언트 배치 크기와 동일하게 32를 사용합니다.
JIPSA_RAG_EMBEDDING_BATCH_SIZE=32

# Qdrant Collection에서 사용할 벡터 거리 함수입니다.
JIPSA_RAG_EMBEDDING_DISTANCE=cosine

# TEI 임베딩 HTTP 요청의 전체 제한 시간입니다.
#
# 단위는 초입니다.
JIPSA_RAG_EMBEDDING_TIMEOUT_SECONDS=60


# =========================================================
# Qdrant Vector Database
# =========================================================

# VectorDB 구현체입니다.
JIPSA_RAG_VECTOR_DB_PROVIDER=qdrant

# 로컬 PC에서 Docker Qdrant REST API에 접근하는 주소입니다.
JIPSA_RAG_QDRANT_URL=http://127.0.0.1:6333

# Qwen3-Embedding-0.6B의 1024차원 벡터를 저장할 Collection 이름입니다.
#
# 임베딩 모델이나 출력 차원이 변경되면
# 기존 Collection을 재사용하지 않고 별도 Collection을 생성합니다.
JIPSA_RAG_QDRANT_COLLECTION=rag_chunk_vector_qwen3_embedding_0_6b_1024

# Qdrant gRPC 연결 포트입니다.
JIPSA_RAG_QDRANT_GRPC_PORT=6334

# 초기 구현에서는 REST API를 사용합니다.
#
# 대량 벡터 적재 최적화가 필요해지면 true로 변경할 수 있습니다.
JIPSA_RAG_QDRANT_PREFER_GRPC=false

# 인증이 활성화된 Qdrant에서 사용할 API Key입니다.
#
# 현재 로컬 Qdrant는 API Key를 사용하지 않으므로 비워 둡니다.
JIPSA_RAG_QDRANT_API_KEY=

# Qdrant 요청 제한 시간입니다.
#
# 단위는 초입니다.
JIPSA_RAG_QDRANT_TIMEOUT_SECONDS=10


# =========================================================
# Claude API Generation
# =========================================================

# 텍스트 생성에 사용할 외부 LLM 공급자입니다.
#
# 현재 생성 클라이언트 구현은 Anthropic Claude API만 지원하므로
# anthropic 이외의 값은 설정 검증 단계에서 거부됩니다.
JIPSA_RAG_GENERATION_PROVIDER=anthropic

# Anthropic Claude API 인증에 사용할 API Key입니다.
#
# 공식 Anthropic Python SDK가 기본으로 사용하는 환경 변수 이름인
# ANTHROPIC_API_KEY를 그대로 사용합니다.
#
# 이 값은 GenerationSettings에서 SecretStr로 읽으므로
# Settings 객체의 repr 또는 일반 로그에 원문이 노출되지 않습니다.
#
# 예시 파일에는 실제 API Key를 입력하지 않습니다.
#
# 실제 API Key는 .env.local, .env.development 또는 OS 환경 변수에만
# 저장하고 소스 코드, 테스트 코드, Git 커밋 및 로그에 남기지 않습니다.
ANTHROPIC_API_KEY=CHANGE_ME_TO_ANTHROPIC_API_KEY

# Claude Messages API 요청에 사용할 모델 ID입니다.
#
# 기본 생성 모델은 Claude Sonnet 5를 사용합니다.
#
# 모델을 교체할 때는 소스 코드를 수정하지 않고
# 환경 변수 값만 변경합니다.
JIPSA_RAG_ANTHROPIC_MODEL=claude-sonnet-5

# 단일 생성 요청에서 허용할 최대 출력 토큰 수입니다.
#
# 이 값은 응답의 최대 길이이며 입력 프롬프트 토큰 수와는 별개입니다.
#
# 실제 허용 한도는 선택한 Claude 모델의 최대 출력 제한을
# 초과할 수 없습니다.
JIPSA_RAG_ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# Claude API 요청 전체에 적용할 제한 시간입니다.
#
# 단위는 초이며 네트워크 장애나 외부 API 지연으로 요청이
# 무기한 대기하지 않도록 제한합니다.
JIPSA_RAG_ANTHROPIC_TIMEOUT_SECONDS=60

# =========================================================
# Answer-level Claude Generation Limits
# =========================================================

# 한 번의 RAG 답변에서 허용할 최대 Claude 호출 횟수입니다.
#
# 최대 20개 참조문서의 문서별 부분 답변과 최종 종합 호출 1회를
# 수용할 수 있도록 기본값은 21입니다.
JIPSA_RAG_ANTHROPIC_MAX_CALLS_PER_ANSWER=21

# 한 번의 RAG 답변 전체에서 허용할 누적 입력 토큰 상한입니다.
#
# 문서별 부분 생성과 최종 종합 생성의 input_tokens를 모두 합산합니다.
JIPSA_RAG_ANTHROPIC_MAX_INPUT_TOKENS_PER_ANSWER=400000

# 한 번의 RAG 답변 전체에서 허용할 누적 출력 토큰 상한입니다.
#
# 부분 답변과 최종 답변의 output_tokens를 모두 합산합니다.
# 단일 호출 상한과는 별도로 적용됩니다.
JIPSA_RAG_ANTHROPIC_MAX_OUTPUT_TOKENS_PER_ANSWER=64000

# 동일 RAG 프로세스에서 동시에 실행할 수 있는 Claude 요청 수입니다.
#
# 모든 HTTP 요청이 공유하는 프로세스 범위 동시성 제한값입니다.
JIPSA_RAG_ANTHROPIC_MAX_CONCURRENT_REQUESTS=2


# =========================================================
# Application Server
# =========================================================

# 파일 manifest 조회와 인제스트 완료 콜백을 처리할
# 애플리케이션 서버의 기본 주소입니다.
#
# URL 끝에는 /를 붙이지 않습니다.
JIPSA_RAG_APP_SERVER_BASE_URL=http://127.0.0.1:8080

# 애플리케이션 서버 일반 API에 공통으로 적용되는 prefix입니다.
#
# 현재 manifest와 ingest-complete API는 /internal/** 루트 경로이므로
# ApplicationServerIngestClient에서는 이 prefix를 사용하지 않습니다.
#
# 향후 API v1 클라이언트에서 사용할 수 있도록 설정은 유지합니다.
JIPSA_RAG_APP_SERVER_API_V1_PREFIX=/api/v1

# 애플리케이션 서버와 TCP 연결을 수립할 때 기다리는 최대 시간입니다.
#
# 단위는 초입니다.
JIPSA_RAG_APP_SERVER_CONNECT_TIMEOUT_SECONDS=5.0

# 연결 후 애플리케이션 서버 응답을 기다리는 최대 시간입니다.
#
# 단위는 초입니다.
JIPSA_RAG_APP_SERVER_READ_TIMEOUT_SECONDS=30.0

# 애플리케이션 서버 내부 API 요청의 최대 시도 횟수입니다.
#
# 최초 요청도 한 번의 시도에 포함됩니다.
JIPSA_RAG_APP_SERVER_MAX_ATTEMPTS=3

# 첫 번째 재시도 전에 대기할 시간입니다.
#
# 이후 재시도마다 지연 시간이 두 배로 증가합니다.
# 단위는 초입니다.
JIPSA_RAG_APP_SERVER_RETRY_INITIAL_DELAY_SECONDS=0.25

# 애플리케이션 서버 요청 재시도 사이에 허용할 최대 대기 시간입니다.
#
# 단위는 초입니다.
JIPSA_RAG_APP_SERVER_RETRY_MAX_DELAY_SECONDS=2.0
