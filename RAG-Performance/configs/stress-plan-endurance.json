{
  "schema_version": 1,
  "suite_name": "issue-159-external-stress-endurance",
  "profile": "endurance",
  "description": "외부 RAG 검색 API의 1~5단계와 5시간 Soak를 실행해 네트워크 포함 장시간 지연 Drift와 오류 누적을 관측한다. Soak는 요청 수 상한 없이 설정 시간 전체를 수행한다.",
  "destructive": false,
  "requires_explicit_confirmation": false,
  "sla_seconds": 3.0,
  "max_total_requests": 300000,
  "stop_policy": {
    "max_error_rate": 0.1,
    "max_p95_ms": 15000.0,
    "max_system_memory_percent": 93.0,
    "max_gpu_memory_percent": 99.0,
    "stop_on_target_exit": false,
    "consecutive_failed_stages": 1
  },
  "stages": [
    {
      "stage_id": "e01-burst",
      "name": "1단계 · 장시간 전 외부 초기 폭주",
      "mode": "burst",
      "operation": "search",
      "enabled": true,
      "destructive": false,
      "total_requests": 500,
      "concurrency": 64,
      "cooldown_seconds": 10.0
    },
    {
      "stage_id": "e02-interval",
      "name": "2단계 · 장시간 전 외부 릴레이",
      "mode": "interval",
      "operation": "search",
      "enabled": true,
      "destructive": false,
      "total_requests": 600,
      "concurrency": 96,
      "interval_seconds": 0.02,
      "cooldown_seconds": 10.0
    },
    {
      "stage_id": "e03-batch",
      "name": "3단계 · 장시간 전 외부 Batch Wave",
      "mode": "batch",
      "operation": "search",
      "enabled": true,
      "destructive": false,
      "total_requests": 1600,
      "batch_size": 80,
      "max_workers": 160,
      "interval_seconds": 0.5,
      "cooldown_seconds": 15.0
    },
    {
      "stage_id": "e04-ramp",
      "name": "4단계 · 장시간 전 외부 처리 한계",
      "mode": "ramp",
      "operation": "search",
      "enabled": true,
      "destructive": false,
      "start_concurrency": 16,
      "step_concurrency": 16,
      "max_concurrency": 128,
      "requests_per_worker": 2,
      "wave_interval_seconds": 3.0,
      "cooldown_seconds": 30.0
    },
    {
      "stage_id": "e05-chaos",
      "name": "5단계 · 외부 30분 피크 복구",
      "mode": "chaos",
      "operation": "search",
      "enabled": true,
      "destructive": false,
      "duration_seconds": 1800.0,
      "baseline_tps": 20,
      "spike_size": 200,
      "spike_interval_seconds": 30.0,
      "max_workers": 256,
      "max_pending_multiplier": 4,
      "cooldown_seconds": 30.0
    },
    {
      "stage_id": "e06-soak",
      "name": "추가 · 외부 5시간 반복 검색",
      "mode": "soak",
      "operation": "search",
      "enabled": true,
      "destructive": false,
      "duration_seconds": 18000.0,
      "window_seconds": 300.0,
      "concurrency": 32,
      "max_requests": 0,
      "cooldown_seconds": 2.0
    }
  ]
}
